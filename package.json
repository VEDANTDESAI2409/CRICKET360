{
  "name": "cricket360",
  "version": "1.0.0",
  "description": "Sports Shop Inventory, GST Billing & Business Management Software",
  "author": "VEDANTDESAI2409",
  "private": true,
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "pretest": "node scripts/switch-bindings.mjs node",
    "test": "npm run pretest && vitest run",
    "test:watch": "npm run pretest && vitest",
    "predev": "node scripts/switch-bindings.mjs electron",
    "dev:renderer": "vite",
    "dev": "npm run predev && node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/switch-bindings.mjs electron && node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "smoke-test": "node scripts/switch-bindings.mjs electron && node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win --x64",
    "verify:package": "node scripts/verify-packaged.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
